#!/usr/bin/env python

Import("env")
Import("env_modules")

env_ai_agent = env_modules.Clone()

# Core module files
env_ai_agent.add_source_files(env.modules_sources, "*.cpp")
env_ai_agent.add_source_files(env.modules_sources, "providers/*.cpp")
env_ai_agent.add_source_files(env.modules_sources, "context/*.cpp")
env_ai_agent.add_source_files(env.modules_sources, "tools/*.cpp")

# Editor-only files (only compiled for editor builds)
if env.editor_build:
    env.add_source_files(env.modules_sources, "editor/*.cpp")
